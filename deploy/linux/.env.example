# OA Agent server stack: every variable read by docker-compose.yml / install.sh / oa-agentctl.
# install.sh writes the real file (mode 0600) with generated secrets. NEVER commit .env or share it:
# OA_SECRET_KEY encrypts saved credentials; losing it makes them unreadable.

# ---- Compose wiring -------------------------------------------------------------------------------------------
COMPOSE_FILE=docker-compose.yml:docker-compose.mounts.yml:docker-compose.build.yml   # layers; + ":docker-compose.https.yml" with a domain; registry mode (install.sh --registry) has NO ":docker-compose.build.yml"
OA_DATA_DIR=./data                                           # caddy/ state only; other paths come from mounts.json
OA_PG_DIR=./data/pg                                          # synced from mounts.json by "oa-agentctl mounts apply"
OA_APP_DIR=./data/app                                        # app data (secret.key)
OA_SPOOL_DIR=./data/spool
OA_ARCHIVE_DIR=./data/archive                                # archive root (may be any absolute host path, e.g. a NAS mount)
OA_SRC_DIR=./src                                             # repository root used for image builds

# ---- Image source (placeholders: no real registry/repo is assumed) --------------------------------------------
OA_VERSION=latest                                            # image tag (registry mode: latest, sha-<7>, 1.2.3 ... ; change with: oa-agentctl upgrade --tag T) / version label
OA_COMMIT=unknown
OA_IMAGE_REGISTRY=oa-agent                                   # registry mode: host[/namespace], images <R>/oa-agent-api|worker|deploy:<VERSION>; e.g. the ACR endpoint of your instance + /koch2333 (docs/部署指南-Linux.md §11). Never put registry passwords here
OA_REPO_URL=                                                 # e.g. https://example.com/PLACEHOLDER/oa-agent  (release tarballs)
OA_PG_IMAGE=postgres:16-alpine
OA_CADDY_IMAGE=caddy:2-alpine

# ---- Build mirrors (set by install.sh --mirror cn; empty = upstream defaults) ------------------------------
OA_BUILD_GOPROXY=
OA_BUILD_NPM_REGISTRY=
OA_BUILD_PIP_INDEX=

# ---- Network ------------------------------------------------------------------------------------------------
OA_PORT=8080                                                 # published host port of the API/UI
OA_BIND_ADDR=0.0.0.0                                         # 127.0.0.1 automatically with a domain
OA_DOMAIN=                                                   # public FQDN (https layer); empty = HTTP only, no Passkeys
OA_ACME_EMAIL=                                               # optional, certificate expiry notices
OA_HTTP_PORT=80                                              # caddy
OA_HTTPS_PORT=443                                            # caddy
OA_PUBLIC_URL=                                               # https://<domain> or http://<host>:<port> (prefills the wizard)
OA_TRUSTED_PROXY=0                                           # 1 only behind caddy / your own reverse proxy that sets X-Forwarded-*

# ---- Secrets (generated by install.sh; do not change after first start) ------------------------------------
OA_POSTGRES_PASSWORD=
OA_WORKER_TOKEN=                                             # >= 32 chars, shared by api + worker
OA_SECRET_KEY=                                               # 64 hex chars

# ---- Application ------------------------------------------------------------------------------------------
OA_STORAGE=on                                                # off: disable the optional storage connections feature
OA_CORS_ORIGINS=                                             # leave empty (same-origin only)
OA_LLM_BASE_URL=                                             # optional first-start seed; normally configure in Settings
OA_LLM_MODEL=
OA_LLM_API_KEY=
OA_LLM_TIMEOUT_SECONDS=60
OA_LOG_LEVEL=
OA_TZ=UTC                                                    # container time zone, e.g. Asia/Shanghai (clock must be correct for TOTP)

# ---- Resource hints / log rotation ---------------------------------------------------------------------------
OA_PG_MEM=1g
OA_API_MEM=1g
OA_WORKER_MEM=3g                                             # OCR is memory hungry
OA_CADDY_MEM=256m
OA_LOG_MAX_SIZE=10m
OA_LOG_MAX_FILE=5
