# The Go process does not load .env files: export these (or, for the Windows package, edit oa-agent.env).
OA_LISTEN_ADDR=127.0.0.1:8080
OA_DATABASE_URL=postgres://oa:change-me@127.0.0.1:5432/oa?sslmode=disable
OA_AUTO_MIGRATE=0                 # 1: apply migrations at start (OA_MIGRATIONS_DIR, default ../migrations)
# Random secret, >= 32 ASCII characters, identical for API and worker. Never commit it.
OA_WORKER_TOKEN=
OA_WORKER_URL=http://127.0.0.1:8090
# Both processes must agree on the spool directory (the worker only reads files below it).
OA_SPOOL_ROOT=./data/spool
OA_ARCHIVE_ROOT=./data/archive
# Optional: serve the built frontend from the API (frontend/dist).
OA_FRONTEND_DIR=
# Recognition engine: configured in the UI (Settings → 识别引擎: presets DeepSeek/Qwen/…, free Base URL and model) and stored in
# the database (API key AES-GCM encrypted). OA_LLM_* below only SEED the first configuration when nothing is saved yet.
OA_LLM_BASE_URL=
OA_LLM_MODEL=
OA_LLM_API_KEY=
OA_LLM_TIMEOUT_SECONDS=60
# Key used to encrypt saved secrets: 64 hex chars. If unset a random key file (data/secret.key, mode 0600) is created.
OA_SECRET_KEY=
# Single-machine package: helpers live next to the exe (set by start.bat).
OA_ALLOW_REVEAL=1               # 0: disable “reveal in Explorer” (Windows, loopback clients only)
OA_STANDALONE=0
OA_POSTGRES_PASSWORD=change-me
# Disposable database for integration tests. Never point at production.
OA_TEST_DATABASE_URL=
OA_STORAGE=on                   # off: disable the optional storage connections feature
OA_LLM_PRESETS_FILE=            # optional JSON file replacing the built-in model presets
OA_ALLOWED_ROOTS=               # worker only: extra read-only roots for preview/render (set to the archive root when running the worker by hand)
OA_CORS_ORIGINS=                # comma-separated exact origins allowed to call the API cross-origin (e.g. http://localhost:5173); empty = same-origin only. Debug builds default to the Vite dev origins. "*" is refused.
OA_LOG_LEVEL=                   # info: silence debug lines in debug builds
OA_PUBLIC_URL=                  # public address users type (e.g. https://oa.example.com); pre-fills the setup wizard's RP ID / origin and overrides what the request claims
OA_TRUSTED_PROXY=               # 1: this server sits behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto (client IP, Secure cookies, loopback check). Leave empty otherwise: those headers are then ignored.
